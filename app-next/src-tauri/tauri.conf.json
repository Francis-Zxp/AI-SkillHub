{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI SkillHub",
  "version": "3.1.11",
  "identifier": "com.franciszhu.aiskillhub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI SkillHub",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "desktop-default"
      ],
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "font-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "worker-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "font-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "worker-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../runtime/SkillHub.ps1": "app-next/runtime/SkillHub.ps1",
      "../runtime/Manage-AgentSkillLinks.ps1": "app-next/runtime/Manage-AgentSkillLinks.ps1",
      "../runtime/Export-SkillHubDiagnostics.ps1": "app-next/runtime/Export-SkillHubDiagnostics.ps1",
      "../runtime/skillhub.config.example.json": "app-next/runtime/skillhub.config.example.json"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5ODE0ODVGMTU4NDU0RDYKUldUV1ZJUVZYMGlCcVhnd09CcFlYTXBQekFKZ0RFdEdDdCt5cHp4WTA2SlorL002cFNMb3RlMVkK",
      "endpoints": [
        "https://github.com/Francis-Zxp/AI-SkillHub/releases/latest/download/latest.json?installed={{current_version}}&channel=stable",
        "https://raw.githubusercontent.com/Francis-Zxp/AI-SkillHub/main/updates/latest.json?installed={{current_version}}&channel=stable",
        "https://cdn.jsdelivr.net/gh/Francis-Zxp/AI-SkillHub@main/updates/latest.json?installed={{current_version}}&channel=stable"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
