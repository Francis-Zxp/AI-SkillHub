{
  "name": "ai-skillhub-next",
  "version": "3.1.9",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test:zip-preview": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./runtime/Test-ZipPreviewImport.ps1",
    "test:source-governance-ui": "node --test ./scripts/source-governance-ui.test.mjs",
    "test:security-review-gate": "node --test ./scripts/security-review-gate-ui.test.mjs",
    "test:ui-v3.0.6": "node --test ./scripts/v3.0.6-ui-contract.test.mjs",
    "test:visual-v3.0.6": "node ./scripts/v3.0.6-visual-qa.cjs",
    "test:ui-v3.0.7": "node --test ./scripts/v3.0.7-ui-contract.test.mjs",
    "test:visual-v3.0.7": "node ./scripts/v3.0.7-visual-qa.cjs",
    "test:v3.1-foundation": "node --test ./scripts/v3.1-readonly-foundation.test.mjs",
    "test:skill-folders": "node --test ./scripts/skill-folders-ui.test.mjs",
    "test:compact-metadata": "node --test ./scripts/compact-metadata-ui.test.mjs",
    "test:codex-delivery": "node --test ./scripts/codex-delivery-contract.test.mjs",
    "test:v3.1.9-update-sync": "node --test ./scripts/v3.1.6-update-sync-contract.test.mjs",
    "test:parent-routing": "node --test ./scripts/parent-routing-contract.test.mjs",
    "test:visual-v3.1": "node ./scripts/v3.1-readonly-visual-qa.cjs",
    "test:visual-v3.1.2-draft": "node ./scripts/v3.1.2-draft-visual-qa.cjs",
    "stop:dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-runtime.ps1",
    "dev:desktop": "pnpm stop:dev && tauri dev",
    "check:toolchain": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/check-toolchain.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "6.0.3",
    "vite": "8.0.14"
  }
}
